# Copy this file to .env.

# Optional fallback RunPod key for your own personal use. Visitors bring their
# own key in the UI; this just lets you skip pasting when testing locally.
RUNPOD_API_KEY=

# Optional: override the default vLLM worker image globally. The UI also has a
# per-launch override under Advanced.
RUNPOD_VLLM_IMAGE=

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel).
# Required only when running the cloudflared service in docker-compose.
CLOUDFLARE_TUNNEL_TOKEN=
